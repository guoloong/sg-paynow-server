# Server port (must match the URL in public/test.html)
PORT=4000

# Default company UEN — used as a fallback when the request body
# does not provide a UEN. Comment out if you don't want a default.
COMPANY_UEN=201912345C

# API shared secret for /api/generate-qr.
# Generate with:    openssl rand -hex 32
# When empty, the server logs a warning and skips the API key check.
# When set, requests to /api/generate-qr must include
# the `X-API-Key: <secret>` header (configured in the WP plugin's API Key field).
PAYNOW_API_SECRET=
